{
  "name": "@mukhtalif/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:node",
    "build:hostinger": "pnpm run verify:hostinger-production && pnpm run build:node",
    "build:node": "esbuild src/node.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/node.cjs",
    "dev": "wrangler dev",
    "deploy": "pnpm run deploy:development",
    "deploy:development": "node ../../scripts/assert-cloudflare-development.mjs && wrangler deploy",
    "start": "pnpm run start:hostinger",
    "start:hostinger": "pnpm run verify:hostinger-production && node dist/node.cjs",
    "verify:hostinger-production": "node ../../scripts/assert-hostinger-production-env.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/lib-storage": "^3.1124.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.7.2",
    "@mukhtalif/types": "workspace:*",
    "@mukhtalif/validation": "workspace:*",
    "@noble/hashes": "^1.8.0",
    "@supabase/supabase-js": "^2.55.0",
    "hono": "^4.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250823.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.30.0"
  }
}
