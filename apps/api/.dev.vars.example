# Copy to .dev.vars. This explicit gate enables the seeded local identity flow.
APP_ENV="development"
DEPLOYMENT_PLATFORM="cloudflare-workers"
ALLOW_DEV_AUTH="true"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Fill these together to use Supabase instead of the in-memory repository.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STUDIO_INVITE_REDIRECT_URL="http://127.0.0.1:3001/login"

# Optional Mailchimp integration. The explicit switch stays false while the
# account is paused. Set it to true only with all seven values configured.
MAILCHIMP_CAMPAIGNS_ENABLED="false"
MAILCHIMP_API_KEY=""
MAILCHIMP_SERVER_PREFIX=""
MAILCHIMP_AUDIENCE_ID=""
# Numeric ID of the existing static Mailchimp tag named exactly `nlpage`.
MAILCHIMP_RECIPIENT_SEGMENT_ID=""
MAILCHIMP_FROM_NAME=""
MAILCHIMP_REPLY_TO=""
PUBLIC_WEB_URL=""

# Optional Mailchimp audience integration for public double opt-in. This is a
# separate credential set from campaign publishing above. Configure all three
# together. The audience ID may be the same legacy audience; the tag is fixed
# server-side to nlpage. With these blank, consent is still saved locally.
NEWSLETTER_MAILCHIMP_SYNC_ENABLED="false"
NEWSLETTER_MAILCHIMP_API_KEY=""
NEWSLETTER_MAILCHIMP_SERVER_PREFIX=""
NEWSLETTER_MAILCHIMP_AUDIENCE_ID=""

# Required outside development whenever the MEDIA R2 binding is enabled.
# Local development derives the current Worker origin when this is blank.
MEDIA_PUBLIC_ORIGIN=""

# Development Resend project. Use a restricted sending-only key authorised for
# devmail.mukhtalif.net. Never paste the production key into this file or into
# Cloudflare. With the key blank, requests remain saved with email unconfigured.
RESEND_ENVIRONMENT="development"
RESEND_API_KEY=""
FORMS_FROM_EMAIL="forms@devmail.mukhtalif.net"
FORM_NOTIFICATION_RECIPIENTS_JSON='{"sponsorship":["aaahashmi95@gmail.com"],"partnership":["aaahashmi95@gmail.com"],"guest_suggestion":["aaahashmi95@gmail.com"],"careers":["aaahashmi95@gmail.com"],"production_service":["aaahashmi95@gmail.com"],"guest_review":["aaahashmi95@gmail.com"]}'

# Required with Supabase and in every deployed environment. Generate a random
# secret of at least 32 bytes and store it as a Worker secret.
FORM_RATE_LIMIT_SECRET=""
