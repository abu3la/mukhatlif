# Production belongs to Hostinger. Copy these names into the Hostinger Node.js
# application's environment-variable panel; do not upload this file as config.
APP_ENV="production"
DEPLOYMENT_PLATFORM="hostinger"
ALLOW_DEV_AUTH="false"
NODE_ENV="production"
# Hostinger injects PORT. One managed reverse-proxy hop is the expected default;
# verify this on the deployed app before accepting public form traffic.
TRUST_PROXY_HOPS="1"

# Use the restricted key from the production Resend project. It must be a
# different key from RESEND_DEVELOPMENT_API_KEY / the Cloudflare Worker secret.
RESEND_ENVIRONMENT="production"
RESEND_API_KEY=""
FORMS_FROM_EMAIL="forms@notify.mukhtalif.net"
FORM_NOTIFICATION_RECIPIENTS_JSON='{"sponsorship":["bd@mukhtalif.net"],"partnership":["bd@mukhtalif.net"],"guest_suggestion":["pr@mukhtalif.net"],"careers":["hr@mukhtalif.net"],"production_service":["bd@mukhtalif.net"],"guest_review":["pr@mukhtalif.net"]}'

# Production media may be stored in R2, but its public origin must be the
# production API/custom media hostname. A workers.dev development origin is
# rejected by the application guard.
MEDIA_PUBLIC_ORIGIN="https://api.mukhtalif.net"

# Bucket-scoped Object Read & Write S3 credentials. Keep both buckets private.
# The endpoint is derived from R2_ACCOUNT_ID and must not be entered separately.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_AUDIO_BUCKET="mukhtalif-audio"
R2_MEDIA_BUCKET="mukhtalif-media"

# Fill the remaining Hostinger-only application values in its secrets panel.
# Acceptance intentionally shares the existing Supabase project with
# development by explicit user decision. Pin the exact ref so a mistyped or
# attacker-controlled hostname cannot receive the server key. Replace both
# values together only when a separate production project is approved later.
PRODUCTION_SUPABASE_PROJECT_REF="pacpdxvujkjvnaeeuute"
SUPABASE_URL="https://pacpdxvujkjvnaeeuute.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
STUDIO_INVITE_REDIRECT_URL="https://studio.mukhtalif.net/invite"
FORM_RATE_LIMIT_SECRET=""
CORS_ALLOWED_ORIGINS="https://studio.mukhtalif.net,https://staging.mukhtalif.net"

# Keep this false until production campaign publishing is approved. Set it to
# true only with all seven values below configured together.
MAILCHIMP_CAMPAIGNS_ENABLED="false"
MAILCHIMP_API_KEY=""
MAILCHIMP_SERVER_PREFIX=""
MAILCHIMP_AUDIENCE_ID=""
# Numeric ID of the existing static Mailchimp tag named exactly `nlpage`.
MAILCHIMP_RECIPIENT_SEGMENT_ID=""
MAILCHIMP_FROM_NAME=""
MAILCHIMP_REPLY_TO=""
# During acceptance, set this to https://staging.mukhtalif.net only when all
# campaign values above are set. Change it to https://mukhtalif.net only at the
# final public cutover.
PUBLIC_WEB_URL=""

# Public newsletter double opt-in uses its own restricted audience credentials.
# Configure all three together. Leaving them blank saves consent locally with
# sync status unconfigured; the API never falls back to campaign credentials.
NEWSLETTER_MAILCHIMP_SYNC_ENABLED="false"
NEWSLETTER_MAILCHIMP_API_KEY=""
NEWSLETTER_MAILCHIMP_SERVER_PREFIX=""
NEWSLETTER_MAILCHIMP_AUDIENCE_ID=""
