{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mukhtalif-api",
  "account_id": "c4b180c5ae20a242ec7024e2fc0a3478",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    "APP_ENV": "production",
    "ALLOW_DEV_AUTH": "false",
  },
  // Supabase URL and service-role key are secrets:
  //   local dev  -> apps/api/.dev.vars (copy .dev.vars.example)
  //   production -> wrangler secret put SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
  // Set STUDIO_INVITE_REDIRECT_URL to the approved HTTPS login/invite-acceptance
  // page, and add the same URL to Supabase Auth's redirect allowlist.
  //
  // Configure CORS_ALLOWED_ORIGINS as a comma-separated allowlist for the
  // deployed admin and public web origins. With no value, browsers receive no
  // cross-origin access.
  //
  // Mailchimp is server-side only. Configure MAILCHIMP_API_KEY with
  // `wrangler secret put`, and configure MAILCHIMP_SERVER_PREFIX,
  // MAILCHIMP_AUDIENCE_ID, MAILCHIMP_FROM_NAME, MAILCHIMP_REPLY_TO and
  // PUBLIC_WEB_URL as deployment variables. All six are required together.
  //
  // Episode audio and sanitized article images live in two private R2 buckets.
  // `wrangler dev` simulates both locally, so these bindings are safe offline.
  // MEDIA_PUBLIC_ORIGIN must be set to the deployed API origin outside
  // development; the API refuses to start otherwise rather than mint image URLs
  // against whatever origin a request happened to arrive on.
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "mukhtalif-audio" },
    { "binding": "MEDIA", "bucket_name": "mukhtalif-media" },
  ],
  "observability": { "enabled": true },
}
