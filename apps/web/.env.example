# Origin of the Hono API. Content reads stay server-side; anonymous public
# forms receive this resolved origin as a prop, never as a NEXT_PUBLIC_ value.
MUKHTALIF_API_URL=http://127.0.0.1:8787

# Public origin of this site. It must match the Worker's PUBLIC_WEB_URL so the
# links in a sent newsletter resolve to the same canonical pages.
PUBLIC_WEB_URL=http://localhost:3000
